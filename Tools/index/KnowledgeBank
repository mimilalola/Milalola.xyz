// ── MARKDOWN → ARTICLE (parse template) ───────────────────────
function parseFrontMatter(md){
  const m=md.match(/^---\s*\n([\s\S]*?)\n---\s*\n?/);
  const fm={}; let body=md;
  if(m){
    body=md.slice(m[0].length);
    m[1].split('\n').forEach(line=>{
      if(!line.trim()||line.trim().startsWith('#')) return;
      const i=line.indexOf(':'); if(i<0) return;
      const k=line.slice(0,i).trim();
      let v=line.slice(i+1).trim().replace(/\s+#.*$/,'').trim().replace(/^["']|["']$/g,'');
      if(v.startsWith('[')&&v.endsWith(']')){
        v=v.slice(1,-1).split(',').map(s=>s.trim().replace(/^["']|["']$/g,'')).filter(Boolean);
      }
      if(k) fm[k]=v;
    });
  }
  return {fm,body};
}
function extractBlock(body,name){
  const re=new RegExp('<!--\\s*LEXIFY:'+name+':START\\s*-->([\\s\\S]*?)<!--\\s*LEXIFY:'+name+':END\\s*-->');
  const m=body.match(re); return m?m[1].trim():'';
}
function stripBlocksAndH1(body){
  return body
    .replace(/<!--\s*LEXIFY:[A-Z]+:START\s*-->[\s\S]*?<!--\s*LEXIFY:[A-Z]+:END\s*-->/g,'')
    .replace(/<!--[\s\S]*?-->/g,'')
    .replace(/^#\s+.*$/m,'')
    .trim();
}
function mdToHtml(md){
  if(!md) return '';
  try{ return (window.marked&&marked.parse)?marked.parse(md):md.replace(/\n\n/g,'<br><br>'); }
  catch(e){ return md.replace(/\n\n/g,'<br><br>'); }
}
function articleFromMarkdown(md){
  const {fm,body}=parseFrontMatter(md);
  const blocks={
    tldr:extractBlock(body,'TLDR'),
    definitions:extractBlock(body,'DEFINITIONS'),
    dates:extractBlock(body,'DATES'),
    faq:extractBlock(body,'FAQ'),
    sources:extractBlock(body,'SOURCES'),
    cta:extractBlock(body,'CTA')
  };
  const main=stripBlocksAndH1(body);
  let tags=fm.topics||fm.tags||[];
  if(typeof tags==='string') tags=tags.split(',').map(s=>s.trim()).filter(Boolean);
  return {
    id:Date.now(),
    title:fm.title||'Untitled article',
    slug:fm.slug||'',
    area:fm.practice_area||'Financial Regulation',
    type:fm.document_type||'Research',
    date:fm.published||new Date().toISOString().split('T')[0],
    last_reviewed:fm.last_reviewed||'',
    author:fm.author||'Lexify',
    reviewer:fm.reviewer||'',
    summary:fm.meta_description||'',
    tags:tags,
    vis:(fm.visibility==='internal')?'internal':'published',
    pages:null,
    starred:false,
    content:{blocks,main},
    fm:fm
  };
}
function renderArticleBody(doc){
  const c=doc.content; if(!c) return '';
  const block=(label,md)=>md?`<div class="article-block"><div class="article-block-label">${label}</div>${mdToHtml(md)}</div>`:'';
  return [
    block('TL;DR',c.blocks.tldr),
    block('Key definitions',c.blocks.definitions),
    `<div>${mdToHtml(c.main)}</div>`,
    block('Deadlines & key dates',c.blocks.dates),
    block('FAQ',c.blocks.faq),
    block('Sources & claim ledger',c.blocks.sources),
    block('Talk to us',c.blocks.cta)
  ].join('');
}
 
// ── SCHEMA.ORG JSON-LD ────────────────────────────────────────
function parseFaqPairs(md){
  const out=[]; if(!md) return out;
  const lines=md.split('\n'); let q=null,a=[];
  lines.forEach(l=>{
    const b=l.match(/^\*\*(.+?)\*\*\s*$/);
    if(b){ if(q) out.push({q:q,a:a.join(' ').trim()}); q=b[1].trim(); a=[]; }
    else if(q&&l.trim()&&!l.trim().startsWith('#')) a.push(l.trim());
  });
  if(q) out.push({q:q,a:a.join(' ').trim()});
  return out;
}
function parseDefPairs(md){
  const out=[]; if(!md) return out;
  md.split('\n').forEach(l=>{
    const m=l.match(/^\*\*(.+?)\*\*\s*[—–-]\s*(.+)$/);
    if(m) out.push({term:m[1].trim(),def:m[2].replace(/\*/g,'').trim()});
  });
  return out;
}
function buildJSONLD(doc){
  const g=[];
  g.push({"@context":"https://schema.org","@type":"Article",headline:doc.title,datePublished:doc.date,dateModified:doc.last_reviewed||doc.date,author:{"@type":"Person",name:doc.author},publisher:{"@type":"Organization",name:"Lexify SA"},description:doc.summary||""});
  const faq=parseFaqPairs(doc.content?doc.content.blocks.faq:'');
  if(faq.length) g.push({"@context":"https://schema.org","@type":"FAQPage",mainEntity:faq.map(x=>({"@type":"Question",name:x.q,acceptedAnswer:{"@type":"Answer",text:x.a}}))});
  const defs=parseDefPairs(doc.content?doc.content.blocks.definitions:'');
  if(defs.length) g.push({"@context":"https://schema.org","@type":"DefinedTermSet",name:doc.title+" — definitions",hasDefinedTerm:defs.map(d=>({"@type":"DefinedTerm",name:d.term,description:d.def}))});
  return g;
}
function injectJSONLD(doc){
  document.querySelectorAll('script[data-lexify-jsonld]').forEach(s=>s.remove());
  if(!doc||!doc.content) return;
  const s=document.createElement('script');
  s.type='application/ld+json';
  s.setAttribute('data-lexify-jsonld','1');
  s.textContent=JSON.stringify(buildJSONLD(doc),null,2);
  document.head.appendChild(s);
}
 
