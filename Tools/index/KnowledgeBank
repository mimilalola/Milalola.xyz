<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Lexify Knowledge Bank</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;}
body{background:#fafafa;color:#1a1a1a;}
:root{--o:#E8521A;--a:#F5A623;}
input,select,textarea{font-family:inherit;font-size:13px;border-radius:8px;border:0.5px solid #ddd;padding:9px 12px;width:100%;background:#fff;color:#1a1a1a;outline:none;}
input:focus,select:focus,textarea:focus{border-color:var(--o);}
button{cursor:pointer;font-family:inherit;}
 
/* PAGE = one full-screen view at a time */
.page{display:none;min-height:100vh;flex-direction:column;}
.page.show{display:flex;}
 
/* TOPBAR */
.topbar{background:#fff;border-bottom:0.5px solid #e8e8e8;padding:0 1.5rem;flex-shrink:0;position:sticky;top:0;z-index:100;}
.tb-inner{max-width:980px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:54px;gap:12px;}
.logo-wrap{display:flex;align-items:center;gap:10px;cursor:pointer;flex-shrink:0;}
.logo-name{font-weight:500;font-size:14px;background:linear-gradient(135deg,#E8521A,#F5A623);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1.1;}
.logo-sub{font-size:9px;color:#aaa;line-height:1;}
.tb-right{display:flex;align-items:center;gap:10px;flex-wrap:nowrap;}
select.lang{font-size:12px;padding:4px 8px;border-radius:8px;border:1px solid rgba(232,82,26,0.4);color:var(--o);font-weight:500;width:auto;background:#fff;}
.btn-grad{background:linear-gradient(135deg,#E8521A,#F5A623);color:#fff;border:none;border-radius:8px;padding:8px 16px;font-weight:500;font-size:13px;}
.btn-outline{background:none;border:1px solid var(--o);color:var(--o);border-radius:8px;padding:7px 14px;font-size:12px;}
.btn-ghost{background:none;border:none;color:#888;font-size:13px;padding:4px 0;}
.btn-staff{background:#FFF0E8;border:1px solid rgba(232,82,26,0.3);color:var(--o);border-radius:7px;padding:5px 14px;font-size:12px;font-weight:500;}
 
/* NAV TABS (employee) */
.nav-tab{background:none;border:none;border-bottom:2px solid transparent;color:#888;font-size:13px;padding:4px 0;white-space:nowrap;}
.nav-tab.on{color:var(--o);border-bottom-color:var(--o);font-weight:500;}
 
/* FOOTER */
.footer{background:#fff;border-top:0.5px solid #eee;padding:13px 1.5rem;flex-shrink:0;margin-top:auto;}
.ft-inner{max-width:980px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;font-size:12px;}
 
/* LOGIN PAGE */
.login-page{background:#fafafa;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;}
.login-box{background:#fff;border:0.5px solid #e8e8e8;border-radius:16px;padding:2.5rem 2rem;width:360px;max-width:94vw;}
.login-logo{display:flex;flex-direction:column;align-items:center;gap:3px;margin-bottom:1.5rem;}
.login-brand{font-weight:500;font-size:20px;background:linear-gradient(135deg,#E8521A,#F5A623);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-top:6px;}
.login-sub{font-size:11px;color:#aaa;letter-spacing:0.5px;}
.field-label{font-size:12px;color:#888;display:block;margin:12px 0 4px;}
.err-msg{font-size:12px;color:#c33;margin-bottom:12px;display:none;}
 
/* CARDS */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;}
.card{background:#fff;border-radius:14px;border:0.5px solid #eee;padding:1.2rem;cursor:pointer;transition:border-color .15s;}
.card:hover{border-color:var(--o);}
.emp-card{background:#fff;border-radius:12px;border:0.5px solid #e8e8e8;padding:1rem;cursor:pointer;transition:border-color .15s;}
.emp-card:hover{border-color:var(--o);}
 
/* BADGES */
.badge{font-size:10px;padding:2px 9px;border-radius:20px;font-weight:500;display:inline-block;}
.b-Notice{background:#E6F1FB;color:#185FA5;}
.b-Research{background:#FFF0E8;color:#E8521A;}
.b-Guide{background:#EAF3DE;color:#3B6D11;}
.b-Update{background:#FAEEDA;color:#854F0B;}
.b-Insight{background:#EEEDFE;color:#4B3FA7;}
.b-pub{background:#EAF3DE;color:#3B6D11;}
.b-int{background:#f0f0f0;color:#888;}
.b-sent{background:#EAF3DE;color:#3B6D11;}
.b-scheduled{background:#FAEEDA;color:#854F0B;}
.b-draft{background:#f0f0f0;color:#888;}
.b-published{background:#EAF3DE;color:#3B6D11;}
 
/* CAROUSEL */
.carousel{display:flex;gap:10px;overflow-x:auto;padding-bottom:6px;scrollbar-width:none;}
.carousel::-webkit-scrollbar{display:none;}
.tc{flex-shrink:0;width:138px;border-radius:12px;border:2px solid #ebebeb;background:#fafafa;padding:.9rem;cursor:pointer;}
.tc.on{border-color:var(--o);background:#FFF0E8;}
.tc .ti{font-size:24px;margin-bottom:6px;}
.tc .tl{font-weight:500;font-size:12px;line-height:1.3;color:#1a1a1a;}
.tc.on .tl{color:var(--o);}
.tc .tn{font-size:11px;color:#bbb;margin-top:3px;}
 
/* HERO */
.hero{background:linear-gradient(160deg,#fff9f7,#fff 60%,#f5f8ff);border-bottom:0.5px solid #f0f0f0;padding:2.5rem 1.5rem;}
.hero-inner{max-width:980px;margin:0 auto;display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start;}
 
/* EMP HERO BANNER */
.emp-banner{background:linear-gradient(135deg,#E8521A,#F5A623);border-radius:14px;padding:1.5rem 2rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:24px;}
 
/* FEED */
.feed-item{background:#fff;border-radius:12px;border:0.5px solid #e8e8e8;padding:1rem 1.2rem;display:flex;gap:14px;cursor:pointer;margin-bottom:10px;transition:border-color .15s;}
.feed-item:hover{border-color:var(--o);}
 
/* STAT */
.stat{background:#f4f4f4;border-radius:10px;padding:1rem;text-align:center;}
.stat-n{font-size:24px;font-weight:500;background:linear-gradient(135deg,#E8521A,#F5A623);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
 
/* CHIP */
.chip{display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:24px;border:1.5px solid #e0e0e0;background:#fff;font-size:12px;color:#666;cursor:pointer;white-space:nowrap;}
.chip.on{border-color:var(--o);background:#FFF0E8;color:var(--o);font-weight:500;}
 
/* AVATAR */
.av{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#E8521A,#F5A623);display:flex;align-items:center;justify-content:center;font-size:11px;color:#fff;font-weight:500;overflow:hidden;flex-shrink:0;}
.av img{width:100%;height:100%;object-fit:cover;}
 
/* NOTIF */
.notif-wrap{position:relative;}
.notif-dd{position:absolute;right:0;top:36px;width:300px;background:#fff;border:0.5px solid #ddd;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,.08);z-index:200;overflow:hidden;display:none;}
.notif-dd.show{display:block;}
 
/* SECTION (inside employee portal) */
.sec{display:none;flex:1;overflow-y:auto;}
.sec.on{display:block;}
.sec-inner{max-width:980px;margin:0 auto;padding:1.5rem 1rem;}
 
/* SUBSCRIBE */
.sub-cta{background:linear-gradient(135deg,#E8521A,#F5A623);border-radius:14px;padding:1.5rem 2rem;}
 
/* POLICY */
.policy-item{margin-bottom:20px;}
.policy-item h4{font-size:14px;font-weight:500;margin-bottom:6px;}
.policy-item p{font-size:13px;color:#555;line-height:1.7;}
 
/* AI bubble */
.ai-bubble{background:#f5f5f5;border-radius:4px 14px 14px 14px;padding:.9rem 1rem;font-size:13px;line-height:1.7;flex:1;border:0.5px solid #e8e8e8;}
 
/* RENDERED ARTICLE (parsed from Markdown) */
.article-render{font-size:14px;line-height:1.75;color:#222;}
.article-render h1{font-size:22px;font-weight:600;margin:0 0 12px;}
.article-render h2{font-size:17px;font-weight:600;margin:22px 0 8px;}
.article-render h3{font-size:14px;font-weight:600;margin:16px 0 6px;}
.article-render p{margin:0 0 12px;}
.article-render ul,.article-render ol{margin:0 0 12px 20px;}
.article-render li{margin-bottom:5px;}
.article-render table{border-collapse:collapse;width:100%;margin:12px 0;font-size:12.5px;}
.article-render th,.article-render td{border:1px solid #e2e2e2;padding:6px 8px;text-align:left;vertical-align:top;}
.article-render th{background:#f5f5f5;font-weight:600;}
.article-block{margin-bottom:22px;padding:14px 16px;border-radius:10px;background:#fafafa;border:0.5px solid #eee;}
.article-block-label{font-size:11px;font-weight:600;color:var(--o);text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px;}
 
/* MISC */
.link{color:var(--o);cursor:pointer;}
.muted{color:#aaa;font-size:11px;}
.sep{color:#ccc;}
.tag{font-size:11px;padding:3px 9px;border-radius:6px;background:#f0f0f0;color:#555;display:inline-block;margin:2px;}
hr.div{border:none;border-top:0.5px solid #eee;margin:12px 0;}
 
@media print{.topbar,.footer,.hero,.sub-cta,.carousel,#kb-about,#print-hide{display:none!important;}}
</style>
</head>
<body>
 
<!-- ===================== KNOWLEDGE BANK ===================== -->
<div id="p-kb" class="page show">
  <div class="topbar">
    <div class="tb-inner">
      <div class="logo-wrap" onclick="goto('p-kb')">
        <svg id="logo-kb" width="26" height="26" viewBox="0 0 36 36"></svg>
        <div><div class="logo-name">LEXIFY</div><div class="logo-sub">Knowledge Bank</div></div>
      </div>
      <div class="tb-right">
        <select class="lang" onchange="setLang(this.value)"><option>EN</option><option>IT</option><option>FR</option><option>DE</option></select>
        <button class="btn-staff" onclick="goto('p-staff-login')">Staff access →</button>
      </div>
    </div>
  </div>
 
  <div class="hero">
    <div class="hero-inner">
      <div style="max-width:500px;flex:1;">
        <p style="font-size:11px;font-weight:500;letter-spacing:1.5px;color:var(--o);margin-bottom:14px;text-transform:uppercase;" id="kb-tagline">More Than Lawyers</p>
        <h1 style="font-size:30px;font-weight:500;line-height:1.25;margin-bottom:16px;" id="kb-hero-title">Legal insights,<br>directly from Lexify.</h1>
        <p style="font-size:15px;color:#666;line-height:1.7;margin-bottom:24px;" id="kb-hero-sub">Research, regulatory notices, and publications — curated for clients and industry professionals.</p>
        <input type="text" id="kb-search" placeholder="Search publications, topics, keywords…" oninput="renderKBGrid()" style="max-width:420px;"/>
      </div>
      <div id="kb-featured" style="display:flex;flex-direction:column;gap:8px;flex:1;min-width:240px;max-width:360px;"></div>
    </div>
  </div>
 
  <!-- Carousel -->
  <div style="background:#fff;border-bottom:0.5px solid #f0f0f0;padding:1.2rem 1.5rem;">
    <div style="max-width:980px;margin:0 auto;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <p style="font-size:13px;font-weight:500;" id="kb-filter-label">Browse by topic</p>
        <div style="display:flex;gap:6px;">
          <button onclick="scroll('kb-car',-1)" style="width:26px;height:26px;border-radius:50%;border:0.5px solid #ddd;background:#fafafa;font-size:13px;">‹</button>
          <button onclick="scroll('kb-car',1)" style="width:26px;height:26px;border-radius:50%;border:0.5px solid #ddd;background:#fafafa;font-size:13px;">›</button>
        </div>
      </div>
      <div class="carousel" id="kb-car"></div>
    </div>
  </div>
 
  <!-- Type filter -->
  <div style="background:#fff;border-bottom:0.5px solid #f0f0f0;padding:0 1.5rem;">
    <div style="max-width:980px;margin:0 auto;display:flex;align-items:center;justify-content:flex-end;height:44px;">
      <select class="lang" id="kb-type" onchange="renderKBGrid()">
        <option value="all">All types</option>
        <option>Notice</option><option>Guide</option><option>Insight</option>
      </select>
    </div>
  </div>
 
  <!-- Grid -->
  <div style="max-width:980px;margin:0 auto;padding:2rem 1rem;flex:1;">
    <h2 style="font-size:16px;font-weight:500;margin-bottom:20px;" id="kb-pub-label">Latest publications</h2>
    <div class="grid" id="kb-grid"></div>
    <div id="kb-empty" style="display:none;text-align:center;padding:3rem;color:#bbb;"><div style="font-size:36px;margin-bottom:12px;">🔍</div><p>No publications found.</p></div>
 
    <!-- Newsletter + Contact -->
    <div id="print-hide" style="display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-top:40px;">
      <div class="sub-cta">
        <h3 style="color:#fff;margin-bottom:6px;font-size:16px;">Stay informed</h3>
        <p style="color:rgba(255,255,255,.8);font-size:13px;margin-bottom:16px;line-height:1.6;">Receive our regulatory updates directly to your inbox.</p>
        <div id="kb-sub-form" style="display:flex;flex-direction:column;gap:8px;">
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <input type="email" id="kb-email" placeholder="your@email.com" style="flex:1;min-width:160px;border:none;border-radius:8px;padding:8px 14px;"/>
            <button class="btn-grad" style="border-radius:8px;border:2px solid rgba(255,255,255,.7);background:none;color:#fff;" onclick="kbSubscribe('kb')">Subscribe</button>
          </div>
          <p style="color:rgba(255,255,255,.6);font-size:11px;">By subscribing you agree to receive our newsletter. Unsubscribe anytime.</p>
        </div>
        <p id="kb-sub-ok" style="color:#fff;font-weight:500;display:none;">You're subscribed! Thank you.</p>
      </div>
      <div style="background:#fff;border-radius:14px;border:0.5px solid #eee;padding:1.5rem;">
        <h3 style="font-size:15px;font-weight:500;margin-bottom:6px;">Questions?</h3>
        <p style="font-size:13px;color:#888;margin-bottom:14px;line-height:1.6;">Our team is available for consultations.</p>
        <button class="btn-grad" style="width:100%;padding:9px 0;" onclick="window.open('https://lexify.io','_blank')">Get in touch</button>
      </div>
    </div>
 
    <!-- About -->
    <div id="kb-about" style="margin-top:16px;background:#fff;border-radius:14px;border:0.5px solid #eee;padding:1.5rem 2rem;display:flex;gap:20px;align-items:center;flex-wrap:wrap;">
      <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
        <svg width="32" height="32" viewBox="0 0 36 36" id="logo-kb2"></svg>
        <div><div class="logo-name" style="font-size:14px;">LEXIFY</div><div style="font-size:10px;color:#aaa;">More Than Lawyers</div></div>
      </div>
      <p style="font-size:13px;color:#777;line-height:1.6;flex:1;">Lexify SA is a Swiss law firm specialising in banking law, financial regulation, blockchain, compliance and risk management. Based in Lugano, with offices in Dubai.</p>
      <button class="btn-outline" onclick="window.open('https://lexify.io','_blank')">lexify.io ↗</button>
    </div>
  </div>
 
  <div class="footer">
    <div class="ft-inner">
      <span style="color:#bbb;">© 2026 Lexify SA · Lugano, Switzerland</span>
      <div style="display:flex;gap:16px;">
        <a class="link" onclick="goto('p-kb-policy')">Legal notice</a>
        <span class="sep">·</span><span style="color:#aaa;">legal@lexify.io</span>
        <span class="sep">·</span><a class="link" onclick="window.open('https://lexify.io','_blank')">lexify.io ↗</a>
      </div>
    </div>
  </div>
  <button id="btt" onclick="window.scrollTo({top:0,behavior:'smooth'})" style="position:fixed;bottom:24px;right:24px;background:linear-gradient(135deg,#E8521A,#F5A623);color:#fff;border:none;border-radius:24px;padding:8px 16px;font-size:12px;font-weight:500;box-shadow:0 2px 12px rgba(232,82,26,.3);display:none;z-index:50;">Back to top ↑</button>
</div>
 
<!-- ===================== KB PUBLICATION DETAIL ===================== -->
<div id="p-kb-detail" class="page">
  <div class="topbar">
    <div class="tb-inner">
      <div class="logo-wrap" onclick="goto('p-kb')">
        <svg width="24" height="24" viewBox="0 0 36 36" id="logo-kbd"></svg>
        <div><div class="logo-name">LEXIFY</div><div class="logo-sub">Knowledge Bank</div></div>
