    <div id="kbd-content-card" style="background:#fff;border-radius:14px;border:0.5px solid #e8e8e8;padding:1.5rem;margin-bottom:20px;">
      <div style="background:#f8f8f8;border-radius:10px;height:260px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:0.5px dashed #ddd;">
        <div style="font-size:44px;opacity:.2;margin-bottom:12px;">📄</div>
