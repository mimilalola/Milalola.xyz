}
 
// ── WATERMARKED DOWNLOAD (standalone HTML) ────────────────────
function slugify(s){ return (s||'article').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,''); }
function downloadArticle(id){
  const doc=DOCS.find(d=>d.id===id)||currentDoc;
  if(!doc||!doc.content){ return; }
  const bodyHtml=renderArticleBody(doc);
  const jsonld=JSON.stringify(buildJSONLD(doc),null,2);
  const wm='© 2026 Lexify SA — for personal use';
  const dlDate=new Date().toISOString().split('T')[0];
  const html=
'<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">'+
'<meta name="viewport" content="width=device-width,initial-scale=1">'+
'<title>'+doc.title+'</title>'+
'<script type="application/ld+json">'+jsonld+'<\/script>'+
'<style>'+
'body{font-family:-apple-system,Segoe UI,sans-serif;color:#1a1a1a;max-width:760px;margin:40px auto;padding:0 22px;line-height:1.75;position:relative;}'+
'h1{font-size:26px;margin:0 0 8px;} h2{font-size:19px;margin:26px 0 8px;} h3{font-size:13px;color:#E8521A;text-transform:uppercase;letter-spacing:.5px;margin:18px 0 6px;}'+
'table{border-collapse:collapse;width:100%;margin:12px 0;font-size:13px;} th,td{border:1px solid #ddd;padding:6px 8px;text-align:left;vertical-align:top;} th{background:#f2f2f2;}'+
'.meta{color:#888;font-size:13px;margin-bottom:20px;}'+
'.blk{background:#fafafa;border:0.5px solid #eee;border-radius:10px;padding:12px 16px;margin:16px 0;}'+
'.wm{position:fixed;inset:0;pointer-events:none;z-index:9999;overflow:hidden;}'+
'.wm span{position:absolute;font-size:20px;font-weight:700;color:#000;opacity:.06;transform:rotate(-30deg);white-space:nowrap;}'+
'.ft{margin-top:40px;border-top:1px solid #eee;padding-top:12px;font-size:11px;color:#888;}'+
'@media print{.wm span{opacity:.10;}}'+
'</style></head><body>'+
'<div class="wm" id="wm"></div>'+
'<h1>'+doc.title+'</h1>'+
'<div class="meta">'+doc.type+' · '+doc.area+' · '+doc.author+' · '+doc.date+(doc.last_reviewed?(' · reviewed '+doc.last_reviewed):'')+'</div>'+
bodyHtml+
'<div class="ft">'+wm+' · &ldquo;'+doc.title+'&rdquo; · downloaded '+dlDate+' · lexify.io</div>'+
'<script>(function(){var w=document.getElementById("wm");var t='+JSON.stringify(wm)+';var h="";for(var y=0;y<3200;y+=170){for(var x=-200;x<1500;x+=360){h+="<span style=\\"top:"+y+"px;left:"+x+"px;\\">"+t+"<\/span>";}}w.innerHTML=h;})();<\/script>'+
'</body></html>';
  const blob=new Blob([html],{type:'text/html'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=(doc.slug||slugify(doc.title))+'.html';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}
 
