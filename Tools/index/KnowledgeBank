        <p style="font-size:12px;color:#ccc;margin-top:6px;">Full PDF viewer loads in production</p>
      </div>
    </div>
    <div class="sub-cta">
      <h3 style="color:#fff;margin-bottom:4px;font-size:16px;">Stay informed</h3>
      <p style="color:rgba(255,255,255,.8);font-size:13px;margin-bottom:16px;">Receive our regulatory updates directly to your inbox.</p>
      <div id="kbd-sub-form" style="display:flex;flex-direction:column;gap:8px;">
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <input type="email" id="kbd-email" placeholder="your@email.com" style="flex:1;min-width:160px;border:none;border-radius:8px;padding:8px 14px;"/>
          <button style="padding:8px 18px;border-radius:8px;border:2px solid rgba(255,255,255,.7);background:none;color:#fff;font-weight:500;font-size:13px;cursor:pointer;" onclick="kbSubscribe('kbd')">Subscribe</button>
        </div>
        <p style="color:rgba(255,255,255,.6);font-size:11px;">By subscribing you agree to receive our newsletter. Unsubscribe anytime.</p>
      </div>
      <p id="kbd-sub-ok" style="color:#fff;font-weight:500;display:none;">You're subscribed! Thank you.</p>
    </div>
  </div>
  <div class="footer"><div class="ft-inner"><span style="color:#bbb;">© 2026 Lexify SA · Lugano, Switzerland</span><a class="link" onclick="goto('p-kb-policy')">Legal notice</a></div></div>
</div>
 
