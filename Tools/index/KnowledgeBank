    <div style="background:#fff;border-radius:14px;border:0.5px solid #e8e8e8;padding:2rem;margin-bottom:20px;">
      <div id="kbd-badges" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;"></div>
      <h1 id="kbd-title" style="font-size:22px;font-weight:500;line-height:1.3;margin-bottom:12px;"></h1>
      <p id="kbd-meta" style="font-size:13px;color:#888;margin-bottom:16px;"></p>
      <p id="kbd-summary" style="font-size:15px;color:#444;line-height:1.8;margin-bottom:20px;"></p>
