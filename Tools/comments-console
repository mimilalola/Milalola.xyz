<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>dev.console</title>
<style>
  :root{
    --bg:#070809;
    --panel:#0d1013;
    --panel-2:#11161a;
    --border:#1d262c;
    --border-soft:#161d22;
    --text:#d8dee3;
    --muted:#66727b;
    --faint:#3b454c;
    --accent:#35d9a6;
    --accent-dim:rgba(53,217,166,.12);
    --accent-line:rgba(53,217,166,.30);
    --danger:#ff5c6c;
    --amber:#e0a94b;
    --mono:'JetBrains Mono','SF Mono',ui-monospace,'Cascadia Code','Fira Code',Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    background:
      radial-gradient(900px 500px at 85% -10%,rgba(53,217,166,.06),transparent 60%),
      linear-gradient(var(--bg),var(--bg));
    color:var(--text);
    font-family:var(--mono);
    font-size:14px;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--accent-dim)}
  ::-webkit-scrollbar{width:10px;height:10px}
  ::-webkit-scrollbar-thumb{background:#1c242a;border-radius:8px;border:2px solid var(--bg)}
  ::-webkit-scrollbar-thumb:hover{background:#27323a}

  /* ---------- top bar ---------- */
  header{
    position:sticky;top:0;z-index:20;
    display:flex;align-items:center;gap:14px;
    padding:16px 22px;
    background:linear-gradient(var(--bg),rgba(7,8,9,.85));
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--border-soft);
  }
  .logo{display:flex;align-items:center;gap:10px;font-weight:600;letter-spacing:.5px}
  .logo .dot{width:9px;height:9px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent)}
  .logo b{color:var(--text)}
  .logo span{color:var(--muted);font-weight:400}
  .cursor{display:inline-block;width:8px;height:15px;background:var(--accent);margin-left:2px;animation:blink 1.1s steps(1) infinite;vertical-align:-2px}
  @keyframes blink{50%{opacity:0}}
  header .spacer{flex:1}
  .meta{color:var(--muted);font-size:12px}
  .meta b{color:var(--accent)}
  .save-note{color:var(--faint);font-size:11.5px;transition:color .2s,opacity .3s;opacity:0}
  .save-note.show{opacity:1;color:var(--accent)}

  /* ---------- grid ---------- */
  main{padding:26px 22px 80px;max-width:1400px;margin:0 auto}
  .grid{
    display:grid;gap:16px;
    grid-template-columns:repeat(auto-fill,minmax(270px,1fr));
  }
  .card{
    background:linear-gradient(180deg,var(--panel-2),var(--panel));
    border:1px solid var(--border);
    border-radius:10px;
    overflow:hidden;
    cursor:pointer;
    transition:border-color .16s,transform .1s,box-shadow .16s;
    display:flex;flex-direction:column;
    min-height:150px;
  }
  .card:hover{border-color:var(--accent-line);box-shadow:0 6px 26px rgba(0,0,0,.4)}
  .card:active{transform:translateY(1px)}
  .card-bar{
    display:flex;align-items:center;gap:8px;
    padding:10px 12px;border-bottom:1px solid var(--border-soft);
    background:rgba(255,255,255,.012);
  }
  .lights{display:flex;gap:6px}
  .lights i{width:9px;height:9px;border-radius:50%;display:block}
  .lights i:nth-child(1){background:#ff5f57}
  .lights i:nth-child(2){background:#febc2e}
  .lights i:nth-child(3){background:#28c840}
  .card-name{
    flex:1;min-width:0;font-size:12.5px;color:var(--text);font-weight:600;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .card-del{
    border:0;background:transparent;color:var(--faint);cursor:pointer;
    font-size:14px;padding:2px 4px;border-radius:5px;line-height:1;
  }
  .card-del:hover{color:var(--danger);background:rgba(255,92,108,.1)}
  .card-body{
    padding:12px 14px;flex:1;font-size:12.5px;color:var(--muted);
    display:flex;flex-direction:column;gap:5px;overflow:hidden;
  }
  .prev-line{display:flex;gap:7px;align-items:flex-start;white-space:nowrap;overflow:hidden}
  .prev-line .b{color:var(--accent);flex:none}
  .prev-line .t{overflow:hidden;text-overflow:ellipsis}
  .prev-line.done .t{text-decoration:line-through;color:var(--faint)}
  .prev-empty{color:var(--faint);font-style:italic}
  .card-foot{
    padding:9px 14px;border-top:1px solid var(--border-soft);
    display:flex;align-items:center;gap:10px;font-size:11px;color:var(--muted);
  }
  .bar{flex:1;height:4px;border-radius:3px;background:#12191d;overflow:hidden}
  .bar>i{display:block;height:100%;background:var(--accent);width:0;transition:width .3s}

  /* new project card */
  .card.new{
    align-items:center;justify-content:center;
    border-style:dashed;color:var(--muted);
    background:transparent;
  }
  .card.new:hover{color:var(--accent);border-color:var(--accent-line)}
  .card.new .plus{font-size:26px;line-height:1;margin-bottom:6px}

  .empty{color:var(--muted);grid-column:1/-1;padding:60px 0;text-align:center}

  /* ---------- modal ---------- */
  .overlay{
    position:fixed;inset:0;z-index:50;display:none;
    background:rgba(3,4,5,.72);backdrop-filter:blur(3px);
    padding:24px;
  }
  .overlay.open{display:flex;align-items:stretch;justify-content:center}
  .modal{
    width:100%;max-width:860px;margin:auto;max-height:100%;
    display:flex;flex-direction:column;
    background:linear-gradient(180deg,var(--panel-2),var(--panel));
    border:1px solid var(--border);border-radius:12px;
    box-shadow:0 24px 80px rgba(0,0,0,.6);
    overflow:hidden;
  }
  .m-bar{
    display:flex;align-items:center;gap:10px;
    padding:12px 16px;border-bottom:1px solid var(--border-soft);
    background:rgba(255,255,255,.012);
  }
  .m-close{
    margin-left:auto;border:1px solid var(--border);background:transparent;
    color:var(--muted);cursor:pointer;border-radius:6px;padding:5px 10px;font-family:var(--mono);font-size:12px;
  }
  .m-close:hover{border-color:var(--danger);color:var(--danger)}
  .m-head{padding:18px 22px 6px}
  .m-title{
    width:100%;background:transparent;border:0;outline:none;
    color:var(--text);font-family:var(--mono);font-size:24px;font-weight:700;
    letter-spacing:.3px;padding:4px 0;
  }
  .m-title::placeholder{color:var(--faint)}
  .m-title-line{height:2px;background:linear-gradient(90deg,var(--accent-line),transparent);border-radius:2px;margin-top:2px}
  .hint{padding:8px 22px 12px;color:var(--faint);font-size:11.5px}
  .hint b{color:var(--muted);font-weight:600}
  .m-body{
    padding:6px 16px 20px;overflow-y:auto;flex:1;
  }
  .lines{display:flex;flex-direction:column}
  .line{
    display:flex;align-items:flex-start;gap:6px;
    padding:3px 6px;border-radius:7px;
  }
  .line:hover{background:rgba(255,255,255,.02)}
  .check{
    flex:none;margin-top:3px;width:16px;height:16px;border-radius:5px;
    border:1.5px solid var(--faint);background:transparent;cursor:pointer;
    display:flex;align-items:center;justify-content:center;color:var(--bg);
    font-size:11px;transition:.12s;padding:0;
  }
  .check:hover{border-color:var(--accent)}
  .line.done .check{background:var(--accent);border-color:var(--accent)}
  .line.done .check::after{content:'✓'}
  .bullet-mk{flex:none;margin-top:1px;color:var(--accent);opacity:0;width:0;transition:opacity .1s;font-size:15px}
  .line.bullet .bullet-mk{opacity:1;width:12px}
  .line textarea{
    flex:1;background:transparent;border:0;outline:none;resize:none;overflow:hidden;
    color:var(--text);font-family:var(--mono);font-size:14px;line-height:1.55;
    padding:1px 0;height:22px;
  }
  .line textarea::placeholder{color:var(--faint)}
  .line.done textarea{text-decoration:line-through;color:var(--faint)}
  .add-line{
    margin:6px 6px 0;padding:5px 8px;border:1px dashed var(--border);border-radius:7px;
    background:transparent;color:var(--muted);cursor:pointer;font-family:var(--mono);font-size:12px;
    width:calc(100% - 12px);text-align:left;
  }
  .add-line:hover{border-color:var(--accent-line);color:var(--accent)}
  .m-foot{
    padding:10px 18px;border-top:1px solid var(--border-soft);
    display:flex;align-items:center;gap:14px;font-size:11.5px;color:var(--muted);
  }
  .m-foot .del{margin-left:auto;background:transparent;border:1px solid var(--border);color:var(--muted);cursor:pointer;border-radius:6px;padding:5px 10px;font-family:var(--mono)}
  .m-foot .del:hover{border-color:var(--danger);color:var(--danger)}
</style>
</head>
<body>

<header>
  <div class="logo"><span class="dot"></span><b>dev</b><span>.console</span><span class="cursor"></span></div>
  <div class="spacer"></div>
  <div class="save-note" id="saveNote">saved ✓</div>
  <div class="meta"><b id="pCount">0</b> projects</div>
</header>

<main>
  <div class="grid" id="grid"></div>
</main>

<!-- modal -->
<div class="overlay" id="overlay">
  <div class="modal" id="modal">
    <div class="m-bar">
      <div class="lights"><i></i><i></i><i></i></div>
      <span class="meta" id="mMeta"></span>
      <button class="m-close" id="mClose">esc · close</button>
    </div>
    <div class="m-head">
      <input class="m-title" id="mTitle" placeholder="untitled project" spellcheck="false">
      <div class="m-title-line"></div>
    </div>
    <div class="hint">start a line with <b>- </b> for a bullet &nbsp;·&nbsp; <b>enter</b> = new line &nbsp;·&nbsp; <b>shift+enter</b> = wrap in same line &nbsp;·&nbsp; click the box to <b>strike through</b></div>
    <div class="m-body">
      <div class="lines" id="lines"></div>
      <button class="add-line" id="addLine">+ add a line</button>
    </div>
    <div class="m-foot">
      <span id="progText">0 / 0 done</span>
      <button class="del" id="delProj">delete project</button>
    </div>
  </div>
</div>

<script>
(function(){
  "use strict";
  const KEY='milalola_dev_console_v1';
  const uid=()=> (crypto.randomUUID?crypto.randomUUID():'id'+Date.now()+Math.random().toString(16).slice(2));

  /* ---------- state ---------- */
  let data={projects:[]};
  try{ const raw=localStorage.getItem(KEY); if(raw) data=JSON.parse(raw); }catch(e){ data={projects:[]}; }
  if(!Array.isArray(data.projects)) data.projects=[];

  let noteTimer=null;
  function save(){
    try{ localStorage.setItem(KEY, JSON.stringify(data)); }catch(e){}
    const n=document.getElementById('saveNote');
    n.classList.add('show'); clearTimeout(noteTimer);
    noteTimer=setTimeout(()=>n.classList.remove('show'),900);
  }

  const grid=document.getElementById('grid');
  const overlay=document.getElementById('overlay');
  const linesEl=document.getElementById('lines');
  const mTitle=document.getElementById('mTitle');
  const mMeta=document.getElementById('mMeta');
  const progText=document.getElementById('progText');

  let openId=null;
  const getProj=id=>data.projects.find(p=>p.id===id);

  /* ---------- grid render ---------- */
  function render(){
    document.getElementById('pCount').textContent=data.projects.length;
    grid.innerHTML='';
    data.projects.forEach(p=>grid.appendChild(cardEl(p)));

    const add=document.createElement('div');
    add.className='card new';
    add.innerHTML='<div class="plus">+</div><div>new project</div>';
    add.onclick=newProject;
    grid.appendChild(add);
  }

  function cardEl(p){
    const lines=p.lines||[];
    const items=lines.filter(l=>l.text.trim()!=='');
    const done=items.filter(l=>l.done).length;
    const pct=items.length?Math.round(done/items.length*100):0;

    const el=document.createElement('div');
    el.className='card';
    el.onclick=()=>openModal(p.id);

    const bar=document.createElement('div');
    bar.className='card-bar';
    bar.innerHTML='<div class="lights"><i></i><i></i><i></i></div>';
    const name=document.createElement('div');
    name.className='card-name';
    name.textContent=p.title||'untitled project';
    const del=document.createElement('button');
    del.className='card-del';del.textContent='✕';del.title='delete';
    del.onclick=e=>{e.stopPropagation();deleteProject(p.id);};
    bar.appendChild(name);bar.appendChild(del);

    const body=document.createElement('div');
    body.className='card-body';
    if(items.length===0){
      const e=document.createElement('div');e.className='prev-empty';e.textContent='// empty — click to edit';body.appendChild(e);
    }else{
      items.slice(0,4).forEach(l=>{
        const row=document.createElement('div');
        row.className='prev-line'+(l.done?' done':'');
        row.innerHTML=(l.bullet?'<span class="b">•</span>':'')+'<span class="t"></span>';
        row.querySelector('.t').textContent=l.text;
        body.appendChild(row);
      });
      if(items.length>4){const m=document.createElement('div');m.className='prev-empty';m.textContent='+ '+(items.length-4)+' more';body.appendChild(m);}
    }

    const foot=document.createElement('div');
    foot.className='card-foot';
    foot.innerHTML='<span>'+done+'/'+items.length+'</span><span class="bar"><i style="width:'+pct+'%"></i></span><span>'+pct+'%</span>';

    el.appendChild(bar);el.appendChild(body);el.appendChild(foot);
    return el;
  }

  /* ---------- project ops ---------- */
  function newProject(){
    const p={id:uid(),title:'',lines:[{id:uid(),text:'',bullet:false,done:false}]};
    data.projects.push(p);save();render();openModal(p.id);
    setTimeout(()=>mTitle.focus(),30);
  }
  function deleteProject(id){
    const p=getProj(id);
    if(!confirm('Delete "'+((p&&p.title)||'untitled project')+'"? This cannot be undone.'))return;
    data.projects=data.projects.filter(x=>x.id!==id);
    save();if(openId===id)closeModal();render();
  }

  /* ---------- modal ---------- */
  function openModal(id){
    openId=id;const p=getProj(id);if(!p)return;
    mTitle.value=p.title||'';
    if(!p.lines||!p.lines.length)p.lines=[{id:uid(),text:'',bullet:false,done:false}];
    renderLines();updateProg();
    mMeta.textContent='// '+p.lines.length+' lines';
    overlay.classList.add('open');
  }
  function closeModal(){overlay.classList.remove('open');openId=null;render();}

  mTitle.addEventListener('input',()=>{const p=getProj(openId);if(!p)return;p.title=mTitle.value;save();});

  function updateProg(){
    const p=getProj(openId);if(!p)return;
    const items=p.lines.filter(l=>l.text.trim()!=='');
    const done=items.filter(l=>l.done).length;
    progText.textContent=done+' / '+items.length+' done';
    mMeta.textContent='// '+p.lines.length+' lines';
  }

  function autosize(t){t.style.height='auto';t.style.height=(t.scrollHeight)+'px';}

  function renderLines(){
    const p=getProj(openId);if(!p)return;
    linesEl.innerHTML='';
    p.lines.forEach((line,idx)=>linesEl.appendChild(lineEl(line,idx)));
    requestAnimationFrame(()=>linesEl.querySelectorAll('textarea').forEach(autosize));
  }

  function lineEl(line,idx){
    const row=document.createElement('div');
    row.className='line'+(line.bullet?' bullet':'')+(line.done?' done':'');
    row.dataset.idx=idx;

    const chk=document.createElement('button');
    chk.className='check';chk.title='mark complete';
    chk.onclick=()=>{line.done=!line.done;row.classList.toggle('done');save();updateProg();};

    const mk=document.createElement('span');mk.className='bullet-mk';mk.textContent='•';

    const ta=document.createElement('textarea');
    ta.rows=1;ta.value=line.text;ta.spellcheck=false;
    if(idx===0&&!line.text)ta.placeholder="type here — '- ' makes a bullet";

    ta.addEventListener('input',()=>{
      // bullet conversion
      if(!line.bullet && ta.value.startsWith('- ')){
        line.bullet=true;ta.value=ta.value.slice(2);row.classList.add('bullet');
        ta.setSelectionRange(0,0);
      }
      line.text=ta.value;autosize(ta);save();updateProg();
    });

    ta.addEventListener('keydown',ev=>{
      const p=getProj(openId);if(!p)return;
      const i=+row.dataset.idx;
      // ENTER -> new line
      if(ev.key==='Enter'&&!ev.shiftKey){
        ev.preventDefault();
        // empty bullet -> exit bullet instead of new line
        if(line.bullet&&line.text===''){line.bullet=false;row.classList.remove('bullet');save();return;}
        const nl={id:uid(),text:'',bullet:line.bullet,done:false};
        p.lines.splice(i+1,0,nl);save();renderLines();updateProg();focusLine(i+1,0);
        return;
      }
      // BACKSPACE at start
      if(ev.key==='Backspace'&&ta.selectionStart===0&&ta.selectionEnd===0){
        if(line.bullet){ev.preventDefault();line.bullet=false;row.classList.remove('bullet');save();return;}
        if(i>0){
          ev.preventDefault();
          const prev=p.lines[i-1];
          const joinPos=prev.text.length;
          prev.text+=line.text;
          p.lines.splice(i,1);save();renderLines();updateProg();focusLine(i-1,joinPos);
        }
        return;
      }
      // ARROW up/down between lines
      if(ev.key==='ArrowDown'&&ta.selectionStart===ta.value.length&&i<p.lines.length-1){
        ev.preventDefault();focusLine(i+1,0);
      }
      if(ev.key==='ArrowUp'&&ta.selectionStart===0&&i>0){
        ev.preventDefault();focusLine(i-1,-1);
      }
    });

    row.appendChild(chk);row.appendChild(mk);row.appendChild(ta);
    return row;
  }

  function focusLine(idx,pos){
    const row=linesEl.querySelector('.line[data-idx="'+idx+'"]');
    if(!row)return;const ta=row.querySelector('textarea');
    ta.focus();
    const p=(pos===-1||pos>ta.value.length)?ta.value.length:pos;
    ta.setSelectionRange(p,p);autosize(ta);
  }

  document.getElementById('addLine').onclick=()=>{
    const p=getProj(openId);if(!p)return;
    const nl={id:uid(),text:'',bullet:false,done:false};
    p.lines.push(nl);save();renderLines();updateProg();focusLine(p.lines.length-1,0);
  };
  document.getElementById('mClose').onclick=closeModal;
  document.getElementById('delProj').onclick=()=>deleteProject(openId);
  overlay.addEventListener('mousedown',e=>{if(e.target===overlay)closeModal();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&overlay.classList.contains('open'))closeModal();});

  render();
})();
</script>
</body>
</html>
